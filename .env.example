# Copy to .env.local. Everything here is optional, the app runs fully offline
# from the bundled seed bank without any of it.

# Supabase project (adds cross-device sync, generated content, graded modes).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Set these as Supabase edge function secrets, never here:
#   supabase secrets set ANTHROPIC_API_KEY=...
#   supabase secrets set GCP_PRICING_API_KEY=...
