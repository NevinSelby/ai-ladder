{
  "expo": {
    "name": "AI Ladder",
    "slug": "ai-ladder",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ailadder",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "dev.nevinselby.ailadder",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#22384F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.nevinselby.ailadder"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#22384F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "primaryColor": "#2F5E8F",
    "splash": {},
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d7f808c3-5b09-4438-b868-16fd61af7189"
      }
    },
    "owner": "nevinselby123",
    "updates": {
      "url": "https://u.expo.dev/d7f808c3-5b09-4438-b868-16fd61af7189"
    }
  }
}
